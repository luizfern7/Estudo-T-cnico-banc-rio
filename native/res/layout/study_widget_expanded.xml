<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/study_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:elevation="3dp" android:background="@drawable/study_widget_background">
<TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MINHA EVOLUÇÃO" android:textSize="10sp" android:letterSpacing="0.12" android:textColor="#BCE2EC"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
<ImageView android:layout_width="26dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/study_flame" android:importantForAccessibility="no"/>
<TextView android:includeFontPadding="false" android:id="@+id/study_streak" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="0 dias de ofensiva" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFCA8B"/>
</LinearLayout>
<TextView android:includeFontPadding="false" android:id="@+id/study_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Conclua uma etapa para começar" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#BCE2EC"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp"><TextView android:includeFontPadding="false" android:id="@+id/study_level" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Nível 1 · Iniciante" android:textSize="10sp" android:textColor="#FFFFFF"/>
<TextView android:includeFontPadding="false" android:id="@+id/study_xp" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:layout_height="wrap_content" android:text="0 XP" android:textSize="10sp" android:textColor="#BCE2EC"/>
</LinearLayout>
<ProgressBar android:id="@+id/study_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="2dp" android:max="100" android:progressTint="#66C9C4" android:progressBackgroundTint="#344653"/>
<TextView android:includeFontPadding="false" android:id="@+id/study_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Hoje: 0/2 etapas · 0/7 dias na semana" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#BCE2EC"/>
</LinearLayout>
