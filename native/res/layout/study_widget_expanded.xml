<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/study_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/study_widget_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📖 Minha Evolução" android:textSize="14sp" android:textColor="#BCE2EC"/>
<TextView android:id="@+id/study_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Iniciante" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/study_xp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 XP" android:textSize="14sp" android:textColor="#FFFFFF"/>
<ProgressBar android:id="@+id/study_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progressTint="#66C9C4" android:progressBackgroundTint="#344653"/>
<TextView android:id="@+id/study_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Hoje: 0/2 etapas · 0/7 dias na semana" android:textSize="13sp" android:textColor="#BCE2EC"/></LinearLayout>
